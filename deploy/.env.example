# 복사해서 저장소 루트의 .env 로 쓴다 (.env 는 git 제외). 운영 서버에서만 실제 값을 채운다.

# Caddy 가 여는 주소. 도메인이면 HTTPS 인증서를 자동으로 받는다. 로컬 점검은 :80
SITE_ADDRESS=mogakco.example.com
# 브라우저가 접속하는 주소. 로그인 후 돌아갈 곳 (Google OAuth 리디렉션 URI 는 ${PUBLIC_URL}/login/oauth2/code/google)
PUBLIC_URL=https://mogakco.example.com
# 로그인 쿠키를 HTTPS 에서만 보낸다. 로컬 HTTP 점검 때만 false
COOKIE_SECURE=true

MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32바이트 이상 아무 값: openssl rand -base64 48
JWT_SECRET=

# 모니터링 (docs/deployment.md "모니터링"). 영문·숫자만: openssl rand -hex 24
# Grafana 관리자(admin) 로그인 비밀번호
GRAFANA_ADMIN_PASSWORD=
# Grafana 가 DB 패널을 그릴 때 쓰는 읽기 전용 MySQL 계정(grafana_reader) 비밀번호
GRAFANA_MYSQL_PASSWORD=
