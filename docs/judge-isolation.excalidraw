    {
      "id": "limits-text",
      "type": "text",
      "x": 660,
      "y": 134,
      "width": 820,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
