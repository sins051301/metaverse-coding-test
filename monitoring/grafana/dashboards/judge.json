          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(judge_slot_run_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
